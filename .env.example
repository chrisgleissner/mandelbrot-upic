# Copy to .env (gitignored) and fill in your Ultimate device's IP address.
ULTIP1 = 192.168.1.xx

# Optional: override the USB/SD port the demo deploys to (default: usb0)
# ULTUSB = usb0

# Devices for `make e2e` (tests/e2e/README.md): host names or IPs, space-separated,
# e.g. one Ultimate 64 / Elite I and one C64 Ultimate or Elite II.
E2E_DEVICES = 192.168.1.xx 192.168.1.yy
